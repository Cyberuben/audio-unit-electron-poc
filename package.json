{
  "name": "audio-unit-effects",
  "version": "0.1.0",
  "private": true,
  "description": "Electron Audio Unit sound isolation proof of concept",
  "main": "src/main.cjs",
  "scripts": {
    "build:native": "node scripts/build-native.cjs",
    "start": "npm run build:native && electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build:native && electron-builder --dir",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:native": "xcrun swift-format format --in-place native/AudioHost.swift"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "prettier": "3.9.10"
  },
  "build": {
    "appId": "dev.audiolab.isolation",
    "productName": "Isolation Lab",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "au-host"
        ]
      }
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.music",
      "identity": null
    },
    "win": {
      "target": "dir"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
